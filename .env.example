# ==============================================================================
# Youth Health Studio - Non-Secret Environment Variables Template
# Copy to .env for local development. Configure all secret keys in deployment
# secret managers (Supabase project secrets / CI secrets), not in source control.
# ==============================================================================

# Public Supabase API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase Anon / Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Public application URL used in links
APP_PUBLIC_BASE_URL=https://your-domain.example

# Non-secret sender identity
EMAIL_FROM=Youth Health Studio <notifications@your-domain.example>

# Secure migration provisioning (non-secret identifier only)
SEED_SUPER_ADMIN_EMAIL=admin@your-domain.example

# SECURITY NOTICE:
# - DO NOT store RESEND_API_KEY, SUPABASE_SERVICE_ROLE_KEY, SMTP_PASS, DB passwords,
#   or access tokens in this file for production.
# - Provision secrets only via secure deployment environment variables.
