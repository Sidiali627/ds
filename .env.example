# ==============================================================================
# Youth Health Studio - Environment Configuration Template
# Copy this file to .env or .env.local and populate with your credentials.
# DO NOT commit real secrets or service-role keys to version control.
# ==============================================================================

# Supabase Project API URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Public Key (Safe for client-side use)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Email Notification Provider (Server-Side / Supabase Secrets only)
# Supported Providers: Resend, SendGrid, SMTP
RESEND_API_KEY=your-resend-api-key-here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=notifications@youthhealthstudio.com

# Security Notice:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY or database connection strings
# in browser-facing code or client environment bundles.
